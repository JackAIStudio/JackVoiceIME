<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 语音面板：录音 + 联网识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 通知栏常驻入口：specialUse 型前台服务（见 VoiceResidentService 注释） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name="com.osfans.trime.TrimeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_app_icon"
        android:label="@string/trime_app_name"
        android:roundIcon="@mipmap/ic_app_icon_round"
        android:theme="@style/Theme.TrimeAppTheme"
        android:hasFragileUserData="true"
        tools:targetApi="29">

        <service
            android:name=".ime.core.TrimeInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name=".provider.RimeDataProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:directBootAware="true"
            android:exported="false"
            tools:node="merge">
            <!-- remove WorkManager default initializer -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Settings activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.LogActivity"
            android:directBootAware="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.settings.theme.ThemeDiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.ClipEditActivity"
            android:autoRemoveFromRecents="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:label="@string/edit"
            android:launchMode="singleInstance"
            android:taskAffinity=".ui.main.LiquidKeyboardEditActivity"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />

        <!-- JackVoice 主界面：对标 Typeless 的四个 Tab -->
        <activity
            android:name=".ui.jackvoice.JackVoiceActivity"
            android:exported="false"
            android:label="@string/trime_app_name" />

        <!--
            通知栏「开始说话」的透明跳板（见 VoiceQuickStartActivity）。

            点通知必须落到一个 Activity 上：实测 MIUI 上 startService / 广播两种
            点击目标都点不动（前者动作送不到，后者干脆没反应）。
            这个界面透明、无动画、不进最近任务，进 onCreate 就 finish。
        -->
        <activity
            android:name=".ime.voice.VoiceQuickStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent" />

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="com.osfans.trime.MainLauncherAlias"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:targetActivity=".ui.jackvoice.JackVoiceActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- All activities must be declared above <activity-alias> tag -->

        <!-- 语音面板：麦克风前台服务（拿麦克风的前提，见 VoiceCaptureService 注释） -->
        <service
            android:name="com.osfans.trime.ime.voice.VoiceCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            通知栏常驻入口：不点输入框也能开录。

            空闲时才挂着，开始录音就撤掉（见 VoiceResidentService 注释）。
            用 specialUse 而不是 microphone：空闲时我们没有「正在用麦克风」这件事，
            也不该要这个资格——MIUI 上 targetSdk 37 的输入法进程起 microphone 型
            前台服务会被判「不在资格状态」直接抛 SecurityException。
        -->
        <service
            android:name="com.osfans.trime.ime.voice.VoiceResidentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在通知栏常驻语音听写入口，点一下开始录音" />
        </service>

        <!--
            常驻通知的点击入口 + 开机补挂。

            `voice.START` 必须写进 intent-filter：通知的 PendingIntent 是广播，
            系统按 action 匹配 manifest 里声明过的 receiver。漏了这条，
            点通知会**完全没反应**（实测踩过：PendingIntent 建对了、服务也在，
            就是点了不动）。
        -->
        <receiver
            android:name="com.osfans.trime.ime.voice.VoiceResidentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.osfans.trime.voice.START" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
